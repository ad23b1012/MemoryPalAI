# ==============================================================================
# MemoryPalAI - Environment Configuration
# ==============================================================================

# --- AI & LLM Services (Required for AI features) ---
# Get your key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here
# Secondary / Backup Google API Key (Automatic failover if primary key hits quota)
GOOGLE_API_KEY_FALLBACK=your_backup_google_api_key_here
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2

# --- Vector Database (Pinecone or auto-fallback to local ChromaDB) ---
# If PINECONE_API_KEY is left empty, the system automatically uses persistent ChromaDB!
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=memorypalai
PINECONE_NAMESPACE=memorypal
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Vector Backend selection: "auto", "pinecone", or "chroma"
VECTOR_BACKEND=auto

# --- Relational Database (Optional - defaults to local SQLite if omitted) ---
POSTGRES_USER=memorypal_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=memorypal
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432

# --- Server Deployment ---
PORT=8501
HOST=0.0.0.0
DEBUG=False
